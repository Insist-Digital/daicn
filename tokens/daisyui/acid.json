{
  "$description": "daisyUI 'acid' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "1rem", "$description": "daisyUI 'acid' theme's own --radius-box value. See design.md for why box is the single anchor used." },
  "background": { "$type": "color", "$value": "oklch(98% 0 0)", "$description": "daisyUI 'acid' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'acid' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(71.9% 0.357 330.759)", "$description": "daisyUI 'acid' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(14.38% 0.071 330.759)", "$description": "daisyUI 'acid' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(95% 0.03 48.25)", "$description": "daisyUI 'acid' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(95% 0 0)", "$description": "daisyUI 'acid' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(55% 0.02 0)" },

  "accent": { "$type": "color", "$value": "oklch(95% 0.02 122.962)", "$description": "daisyUI 'acid' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(64.84% 0.293 29.349)", "$description": "daisyUI 'acid' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(12.968% 0.058 29.349)", "$description": "daisyUI 'acid' error-content" },

  "info": { "$type": "color", "$value": "oklch(60.72% 0.227 252.05)", "$description": "daisyUI 'acid' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(12.144% 0.045 252.05)", "$description": "daisyUI 'acid' info-content" },
  "success": { "$type": "color", "$value": "oklch(85.72% 0.266 158.53)", "$description": "daisyUI 'acid' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(17.144% 0.053 158.53)", "$description": "daisyUI 'acid' success-content" },
  "warning": { "$type": "color", "$value": "oklch(91.01% 0.212 100.5)", "$description": "daisyUI 'acid' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(18.202% 0.042 100.5)", "$description": "daisyUI 'acid' warning-content" },

  "border": { "$type": "color", "$value": "oklch(91% 0 0)", "$description": "daisyUI 'acid' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(92.78% 0.264 122.962)", "$description": "daisyUI 'acid' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
