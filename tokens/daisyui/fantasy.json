{
  "$description": "daisyUI 'fantasy' theme, remapped to shadcn's CSS variable naming convention.",
  "background": { "$type": "color", "$value": "oklch(100% 0 0)", "$description": "daisyUI 'fantasy' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(27.807% 0.029 256.847)", "$description": "daisyUI 'fantasy' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(37.45% 0.189 325.02)", "$description": "daisyUI 'fantasy' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(87.49% 0.037 325.02)", "$description": "daisyUI 'fantasy' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(93% 0.03 241.36)", "$description": "daisyUI 'fantasy' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(93% 0 0)", "$description": "daisyUI 'fantasy' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(55% 0.02 256.847)" },

  "accent": { "$type": "color", "$value": "oklch(93% 0.02 56.72)", "$description": "daisyUI 'fantasy' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(71.76% 0.221 22.18)", "$description": "daisyUI 'fantasy' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'fantasy' error-content" },

  "info": { "$type": "color", "$value": "oklch(72.06% 0.191 231.6)", "$description": "daisyUI 'fantasy' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'fantasy' info-content" },
  "success": { "$type": "color", "$value": "oklch(64.8% 0.15 160)", "$description": "daisyUI 'fantasy' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'fantasy' success-content" },
  "warning": { "$type": "color", "$value": "oklch(84.71% 0.199 83.87)", "$description": "daisyUI 'fantasy' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'fantasy' warning-content" },

  "border": { "$type": "color", "$value": "oklch(86% 0 0)", "$description": "daisyUI 'fantasy' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(75.98% 0.204 56.72)", "$description": "daisyUI 'fantasy' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
