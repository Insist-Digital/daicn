{
  "$description": "daisyUI 'valentine' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "1rem", "$description": "daisyUI 'valentine' theme's own --radius-box value. Note: this theme's own --radius-field is 2rem, notably larger than box — the box anchor undershoots this theme's field/control roundness more than most. See design.md for the box-anchor compromise." },
  "background": { "$type": "color", "$value": "oklch(97% 0.014 343.198)", "$description": "daisyUI 'valentine' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(52% 0.223 3.958)", "$description": "daisyUI 'valentine' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(65% 0.241 354.308)", "$description": "daisyUI 'valentine' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(100% 0 0)", "$description": "daisyUI 'valentine' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(94% 0.03 303.9)", "$description": "daisyUI 'valentine' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(94% 0.028 342.258)", "$description": "daisyUI 'valentine' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(55% 0.02 3.958)" },

  "accent": { "$type": "color", "$value": "oklch(94% 0.02 230.318)", "$description": "daisyUI 'valentine' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(63% 0.237 25.331)", "$description": "daisyUI 'valentine' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(97% 0.013 17.38)", "$description": "daisyUI 'valentine' error-content" },

  "info": { "$type": "color", "$value": "oklch(86% 0.127 207.078)", "$description": "daisyUI 'valentine' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(44% 0.11 240.79)", "$description": "daisyUI 'valentine' info-content" },
  "success": { "$type": "color", "$value": "oklch(84% 0.143 164.978)", "$description": "daisyUI 'valentine' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(43% 0.095 166.913)", "$description": "daisyUI 'valentine' success-content" },
  "warning": { "$type": "color", "$value": "oklch(75% 0.183 55.934)", "$description": "daisyUI 'valentine' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(26% 0.079 36.259)", "$description": "daisyUI 'valentine' warning-content" },

  "border": { "$type": "color", "$value": "oklch(89% 0.061 343.231)", "$description": "daisyUI 'valentine' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(82% 0.111 230.318)", "$description": "daisyUI 'valentine' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
