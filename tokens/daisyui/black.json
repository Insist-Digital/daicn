{
  "$description": "daisyUI 'black' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "0rem", "$description": "daisyUI 'black' theme's own --radius-box value. See design.md for why box is the single anchor used." },
  "background": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'black' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(87.609% 0 0)", "$description": "daisyUI 'black' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(35% 0 0)", "$description": "daisyUI 'black' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(100% 0 0)", "$description": "daisyUI 'black' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(19% 0.03 0)", "$description": "daisyUI 'black' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(19% 0 0)", "$description": "daisyUI 'black' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(65% 0.02 0)" },

  "accent": { "$type": "color", "$value": "oklch(19% 0.02 0)", "$description": "daisyUI 'black' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(62.795% 0.257 29.233)", "$description": "daisyUI 'black' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(12.559% 0.051 29.233)", "$description": "daisyUI 'black' error-content" },

  "info": { "$type": "color", "$value": "oklch(45.201% 0.313 264.052)", "$description": "daisyUI 'black' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(89.04% 0.062 264.052)", "$description": "daisyUI 'black' info-content" },
  "success": { "$type": "color", "$value": "oklch(51.975% 0.176 142.495)", "$description": "daisyUI 'black' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(90.395% 0.035 142.495)", "$description": "daisyUI 'black' success-content" },
  "warning": { "$type": "color", "$value": "oklch(96.798% 0.211 109.769)", "$description": "daisyUI 'black' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(19.359% 0.042 109.769)", "$description": "daisyUI 'black' warning-content" },

  "border": { "$type": "color", "$value": "oklch(22% 0 0)", "$description": "daisyUI 'black' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(35% 0 0)", "$description": "daisyUI 'black' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
