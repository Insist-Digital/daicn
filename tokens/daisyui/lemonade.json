{
  "$description": "daisyUI 'lemonade' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "1rem", "$description": "daisyUI 'lemonade' theme's own --radius-box value. Note: this theme's own --radius-field is 0.5rem, notably smaller than box — the box anchor overshoots this theme's field roundness. See design.md for the box-anchor compromise." },
  "background": { "$type": "color", "$value": "oklch(98.71% 0.02 123.72)", "$description": "daisyUI 'lemonade' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(19.742% 0.004 123.72)", "$description": "daisyUI 'lemonade' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(58.92% 0.199 134.6)", "$description": "daisyUI 'lemonade' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(11.784% 0.039 134.6)", "$description": "daisyUI 'lemonade' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(91.8% 0.03 111.09)", "$description": "daisyUI 'lemonade' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(91.8% 0.018 123.72)", "$description": "daisyUI 'lemonade' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(55% 0.02 123.72)" },

  "accent": { "$type": "color", "$value": "oklch(91.8% 0.02 100.73)", "$description": "daisyUI 'lemonade' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(86.19% 0.047 25.85)", "$description": "daisyUI 'lemonade' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(17.238% 0.009 25.85)", "$description": "daisyUI 'lemonade' error-content" },

  "info": { "$type": "color", "$value": "oklch(86.19% 0.047 224.14)", "$description": "daisyUI 'lemonade' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(17.238% 0.009 224.14)", "$description": "daisyUI 'lemonade' info-content" },
  "success": { "$type": "color", "$value": "oklch(86.19% 0.047 157.85)", "$description": "daisyUI 'lemonade' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(17.238% 0.009 157.85)", "$description": "daisyUI 'lemonade' success-content" },
  "warning": { "$type": "color", "$value": "oklch(86.19% 0.047 102.15)", "$description": "daisyUI 'lemonade' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(17.238% 0.009 102.15)", "$description": "daisyUI 'lemonade' warning-content" },

  "border": { "$type": "color", "$value": "oklch(84.89% 0.017 123.72)", "$description": "daisyUI 'lemonade' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(85.39% 0.201 100.73)", "$description": "daisyUI 'lemonade' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
