{
  "$description": "daisyUI 'wireframe' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "0.25rem", "$description": "daisyUI 'wireframe' theme's own --radius-box value. Note: this theme's own --radius-selector is 0rem, notably smaller than box — the box anchor overshoots this theme's selector roundness. See design.md for the box-anchor compromise." },
  "background": { "$type": "color", "$value": "oklch(100% 0 0)", "$description": "daisyUI 'wireframe' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(20% 0 0)", "$description": "daisyUI 'wireframe' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(87% 0 0)", "$description": "daisyUI 'wireframe' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(26% 0 0)", "$description": "daisyUI 'wireframe' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(97% 0.03 0)", "$description": "daisyUI 'wireframe' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(97% 0 0)", "$description": "daisyUI 'wireframe' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(55% 0.02 0)" },

  "accent": { "$type": "color", "$value": "oklch(97% 0.02 0)", "$description": "daisyUI 'wireframe' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(44% 0.177 26.899)", "$description": "daisyUI 'wireframe' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(88% 0.062 18.334)", "$description": "daisyUI 'wireframe' error-content" },

  "info": { "$type": "color", "$value": "oklch(44% 0.11 240.79)", "$description": "daisyUI 'wireframe' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(90% 0.058 230.902)", "$description": "daisyUI 'wireframe' info-content" },
  "success": { "$type": "color", "$value": "oklch(43% 0.095 166.913)", "$description": "daisyUI 'wireframe' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(90% 0.093 164.15)", "$description": "daisyUI 'wireframe' success-content" },
  "warning": { "$type": "color", "$value": "oklch(47% 0.137 46.201)", "$description": "daisyUI 'wireframe' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(92% 0.12 95.746)", "$description": "daisyUI 'wireframe' warning-content" },

  "border": { "$type": "color", "$value": "oklch(94% 0 0)", "$description": "daisyUI 'wireframe' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(87% 0 0)", "$description": "daisyUI 'wireframe' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
