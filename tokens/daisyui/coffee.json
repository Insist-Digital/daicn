{
  "$description": "daisyUI 'coffee' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "1rem", "$description": "daisyUI 'coffee' theme's own --radius-box value. Note: this theme's own --radius-field is 0.5rem, notably smaller than box — the box anchor overshoots this theme's field roundness. See design.md for the box-anchor compromise." },
  "background": { "$type": "color", "$value": "oklch(24% 0.023 329.708)", "$description": "daisyUI 'coffee' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(72.354% 0.092 79.129)", "$description": "daisyUI 'coffee' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(71.996% 0.123 62.756)", "$description": "daisyUI 'coffee' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(14.399% 0.024 62.756)", "$description": "daisyUI 'coffee' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(21% 0.03 199.194)", "$description": "daisyUI 'coffee' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(21% 0.021 329.708)", "$description": "daisyUI 'coffee' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(65% 0.02 79.129)" },

  "accent": { "$type": "color", "$value": "oklch(21% 0.02 224.389)", "$description": "daisyUI 'coffee' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(77.318% 0.128 31.871)", "$description": "daisyUI 'coffee' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(15.463% 0.025 31.871)", "$description": "daisyUI 'coffee' error-content" },

  "info": { "$type": "color", "$value": "oklch(79.49% 0.063 184.558)", "$description": "daisyUI 'coffee' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(15.898% 0.012 184.558)", "$description": "daisyUI 'coffee' info-content" },
  "success": { "$type": "color", "$value": "oklch(74.722% 0.072 131.116)", "$description": "daisyUI 'coffee' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(14.944% 0.014 131.116)", "$description": "daisyUI 'coffee' success-content" },
  "warning": { "$type": "color", "$value": "oklch(88.15% 0.14 87.722)", "$description": "daisyUI 'coffee' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(17.63% 0.028 87.722)", "$description": "daisyUI 'coffee' warning-content" },

  "border": { "$type": "color", "$value": "oklch(16% 0.019 329.708)", "$description": "daisyUI 'coffee' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(42.621% 0.074 224.389)", "$description": "daisyUI 'coffee' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
