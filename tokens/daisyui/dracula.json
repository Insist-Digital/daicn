{
  "$description": "daisyUI 'dracula' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "1rem", "$description": "daisyUI 'dracula' theme's own --radius-box value. Note: this theme's own --radius-field is 0.5rem, notably smaller than box — the box anchor overshoots this theme's field roundness. See design.md for the box-anchor compromise." },
  "background": { "$type": "color", "$value": "oklch(28.822% 0.022 277.508)", "$description": "daisyUI 'dracula' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(97.747% 0.007 106.545)", "$description": "daisyUI 'dracula' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(75.461% 0.183 346.812)", "$description": "daisyUI 'dracula' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(15.092% 0.036 346.812)", "$description": "daisyUI 'dracula' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(26.805% 0.03 301.883)", "$description": "daisyUI 'dracula' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(26.805% 0.02 277.508)", "$description": "daisyUI 'dracula' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(65% 0.02 106.545)" },

  "accent": { "$type": "color", "$value": "oklch(26.805% 0.02 66.558)", "$description": "daisyUI 'dracula' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(68.22% 0.206 24.43)", "$description": "daisyUI 'dracula' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(13.644% 0.041 24.43)", "$description": "daisyUI 'dracula' error-content" },

  "info": { "$type": "color", "$value": "oklch(88.263% 0.093 212.846)", "$description": "daisyUI 'dracula' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(17.652% 0.018 212.846)", "$description": "daisyUI 'dracula' info-content" },
  "success": { "$type": "color", "$value": "oklch(87.099% 0.219 148.024)", "$description": "daisyUI 'dracula' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(17.419% 0.043 148.024)", "$description": "daisyUI 'dracula' success-content" },
  "warning": { "$type": "color", "$value": "oklch(95.533% 0.134 112.757)", "$description": "daisyUI 'dracula' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(19.106% 0.026 112.757)", "$description": "daisyUI 'dracula' warning-content" },

  "border": { "$type": "color", "$value": "oklch(24.787% 0.019 277.508)", "$description": "daisyUI 'dracula' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(83.392% 0.124 66.558)", "$description": "daisyUI 'dracula' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
