{
  "$description": "daisyUI 'business' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "0.25rem", "$description": "daisyUI 'business' theme's own --radius-box value. Note: this theme's own --radius-selector is 0rem, notably smaller than box — the box anchor overshoots this theme's selector roundness. See design.md for the box-anchor compromise." },
  "background": { "$type": "color", "$value": "oklch(24.353% 0 0)", "$description": "daisyUI 'business' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(84.87% 0 0)", "$description": "daisyUI 'business' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(41.703% 0.099 251.473)", "$description": "daisyUI 'business' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(88.34% 0.019 251.473)", "$description": "daisyUI 'business' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(22.648% 0.03 229.389)", "$description": "daisyUI 'business' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(22.648% 0 0)", "$description": "daisyUI 'business' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(65% 0.02 0)" },

  "accent": { "$type": "color", "$value": "oklch(22.648% 0.02 35.791)", "$description": "daisyUI 'business' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(51.61% 0.146 29.674)", "$description": "daisyUI 'business' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(90.322% 0.029 29.674)", "$description": "daisyUI 'business' error-content" },

  "info": { "$type": "color", "$value": "oklch(62.616% 0.143 240.033)", "$description": "daisyUI 'business' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(12.523% 0.028 240.033)", "$description": "daisyUI 'business' info-content" },
  "success": { "$type": "color", "$value": "oklch(70.226% 0.094 156.596)", "$description": "daisyUI 'business' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(14.045% 0.018 156.596)", "$description": "daisyUI 'business' success-content" },
  "warning": { "$type": "color", "$value": "oklch(77.482% 0.115 81.519)", "$description": "daisyUI 'business' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(15.496% 0.023 81.519)", "$description": "daisyUI 'business' warning-content" },

  "border": { "$type": "color", "$value": "oklch(20.944% 0 0)", "$description": "daisyUI 'business' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(67.271% 0.167 35.791)", "$description": "daisyUI 'business' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
