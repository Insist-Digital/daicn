{
  "$description": "daisyUI 'lofi' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "0.5rem", "$description": "daisyUI 'lofi' theme's own --radius-box value. Note: this theme's own --radius-selector is 2rem, notably larger than box; this theme's own --radius-field is 0.25rem, notably smaller than box — the box anchor undershoots this theme's selector/field roundness. See design.md for the box-anchor compromise." },
  "background": { "$type": "color", "$value": "oklch(100% 0 0)", "$description": "daisyUI 'lofi' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'lofi' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(15.906% 0 0)", "$description": "daisyUI 'lofi' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(100% 0 0)", "$description": "daisyUI 'lofi' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(97% 0.03 17.278)", "$description": "daisyUI 'lofi' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(97% 0 0)", "$description": "daisyUI 'lofi' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(55% 0.02 0)" },

  "accent": { "$type": "color", "$value": "oklch(97% 0.02 0)", "$description": "daisyUI 'lofi' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(78.66% 0.15 28.47)", "$description": "daisyUI 'lofi' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(15.732% 0.03 28.47)", "$description": "daisyUI 'lofi' error-content" },

  "info": { "$type": "color", "$value": "oklch(79.54% 0.103 205.9)", "$description": "daisyUI 'lofi' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(15.908% 0.02 205.9)", "$description": "daisyUI 'lofi' info-content" },
  "success": { "$type": "color", "$value": "oklch(90.13% 0.153 164.14)", "$description": "daisyUI 'lofi' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(18.026% 0.03 164.14)", "$description": "daisyUI 'lofi' success-content" },
  "warning": { "$type": "color", "$value": "oklch(88.37% 0.135 79.94)", "$description": "daisyUI 'lofi' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(17.674% 0.027 79.94)", "$description": "daisyUI 'lofi' warning-content" },

  "border": { "$type": "color", "$value": "oklch(94% 0 0)", "$description": "daisyUI 'lofi' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(26.861% 0 0)", "$description": "daisyUI 'lofi' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
