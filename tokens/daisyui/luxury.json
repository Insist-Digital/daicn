{
  "$description": "daisyUI 'luxury' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "1rem", "$description": "daisyUI 'luxury' theme's own --radius-box value. Note: this theme's own --radius-field is 0.5rem, notably smaller than box — the box anchor overshoots this theme's field roundness. See design.md for the box-anchor compromise." },
  "background": { "$type": "color", "$value": "oklch(14.076% 0.004 285.822)", "$description": "daisyUI 'luxury' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(75.687% 0.123 76.89)", "$description": "daisyUI 'luxury' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(100% 0 0)", "$description": "daisyUI 'luxury' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(20% 0 0)", "$description": "daisyUI 'luxury' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(20.219% 0.03 261.069)", "$description": "daisyUI 'luxury' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(20.219% 0.004 308.229)", "$description": "daisyUI 'luxury' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(65% 0.02 76.89)" },

  "accent": { "$type": "color", "$value": "oklch(20.219% 0.02 338.825)", "$description": "daisyUI 'luxury' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(71.753% 0.176 22.568)", "$description": "daisyUI 'luxury' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(14.35% 0.035 22.568)", "$description": "daisyUI 'luxury' error-content" },

  "info": { "$type": "color", "$value": "oklch(79.061% 0.121 237.133)", "$description": "daisyUI 'luxury' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(15.812% 0.024 237.133)", "$description": "daisyUI 'luxury' info-content" },
  "success": { "$type": "color", "$value": "oklch(78.119% 0.192 132.154)", "$description": "daisyUI 'luxury' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(15.623% 0.038 132.154)", "$description": "daisyUI 'luxury' success-content" },
  "warning": { "$type": "color", "$value": "oklch(86.127% 0.136 102.891)", "$description": "daisyUI 'luxury' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(17.225% 0.027 102.891)", "$description": "daisyUI 'luxury' warning-content" },

  "border": { "$type": "color", "$value": "oklch(23.219% 0.004 308.229)", "$description": "daisyUI 'luxury' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(36.674% 0.051 338.825)", "$description": "daisyUI 'luxury' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
