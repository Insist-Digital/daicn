{
  "$description": "daisyUI 'nord' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "0.5rem", "$description": "daisyUI 'nord' theme's own --radius-box value. Note: this theme's own --radius-selector is 1rem, notably larger than box — the box anchor undershoots this theme's selector roundness. See design.md for the box-anchor compromise." },
  "background": { "$type": "color", "$value": "oklch(95.127% 0.007 260.731)", "$description": "daisyUI 'nord' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(32.437% 0.022 264.182)", "$description": "daisyUI 'nord' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(59.435% 0.077 254.027)", "$description": "daisyUI 'nord' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(11.887% 0.015 254.027)", "$description": "daisyUI 'nord' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(93.299% 0.03 248.687)", "$description": "daisyUI 'nord' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(93.299% 0.01 261.788)", "$description": "daisyUI 'nord' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(55% 0.02 264.182)" },

  "accent": { "$type": "color", "$value": "oklch(93.299% 0.02 217.469)", "$description": "daisyUI 'nord' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(60.61% 0.12 15.341)", "$description": "daisyUI 'nord' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(12.122% 0.024 15.341)", "$description": "daisyUI 'nord' error-content" },

  "info": { "$type": "color", "$value": "oklch(69.207% 0.062 332.664)", "$description": "daisyUI 'nord' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(13.841% 0.012 332.664)", "$description": "daisyUI 'nord' info-content" },
  "success": { "$type": "color", "$value": "oklch(76.827% 0.074 131.063)", "$description": "daisyUI 'nord' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(15.365% 0.014 131.063)", "$description": "daisyUI 'nord' success-content" },
  "warning": { "$type": "color", "$value": "oklch(85.486% 0.089 84.093)", "$description": "daisyUI 'nord' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(17.097% 0.017 84.093)", "$description": "daisyUI 'nord' warning-content" },

  "border": { "$type": "color", "$value": "oklch(89.925% 0.016 262.749)", "$description": "daisyUI 'nord' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(77.464% 0.062 217.469)", "$description": "daisyUI 'nord' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
