{
  "$description": "daisyUI 'synthwave' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "1rem", "$description": "daisyUI 'synthwave' theme's own --radius-box value. Note: this theme's own --radius-field is 0.5rem, notably smaller than box — the box anchor overshoots this theme's field roundness. See design.md for the box-anchor compromise." },
  "background": { "$type": "color", "$value": "oklch(15% 0.09 281.288)", "$description": "daisyUI 'synthwave' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(78% 0.115 274.713)", "$description": "daisyUI 'synthwave' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(71% 0.202 349.761)", "$description": "daisyUI 'synthwave' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(28% 0.109 3.907)", "$description": "daisyUI 'synthwave' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(20% 0.03 230.318)", "$description": "daisyUI 'synthwave' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(20% 0.09 281.288)", "$description": "daisyUI 'synthwave' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(65% 0.02 274.713)" },

  "accent": { "$type": "color", "$value": "oklch(20% 0.02 55.934)", "$description": "daisyUI 'synthwave' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(73.7% 0.121 32.639)", "$description": "daisyUI 'synthwave' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(23.501% 0.096 290.329)", "$description": "daisyUI 'synthwave' error-content" },

  "info": { "$type": "color", "$value": "oklch(74% 0.16 232.661)", "$description": "daisyUI 'synthwave' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(29% 0.066 243.157)", "$description": "daisyUI 'synthwave' info-content" },
  "success": { "$type": "color", "$value": "oklch(77% 0.152 181.912)", "$description": "daisyUI 'synthwave' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(27% 0.046 192.524)", "$description": "daisyUI 'synthwave' success-content" },
  "warning": { "$type": "color", "$value": "oklch(90% 0.182 98.111)", "$description": "daisyUI 'synthwave' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(42% 0.095 57.708)", "$description": "daisyUI 'synthwave' warning-content" },

  "border": { "$type": "color", "$value": "oklch(25% 0.09 281.288)", "$description": "daisyUI 'synthwave' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(75% 0.183 55.934)", "$description": "daisyUI 'synthwave' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
