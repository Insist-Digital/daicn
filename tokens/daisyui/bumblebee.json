{
  "$description": "daisyUI 'bumblebee' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "1rem", "$description": "daisyUI 'bumblebee' theme's own --radius-box value. See design.md for why box is the single anchor used." },
  "background": { "$type": "color", "$value": "oklch(100% 0 0)", "$description": "daisyUI 'bumblebee' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(20% 0 0)", "$description": "daisyUI 'bumblebee' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(85% 0.199 91.936)", "$description": "daisyUI 'bumblebee' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(42% 0.095 57.708)", "$description": "daisyUI 'bumblebee' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(97% 0.03 55.934)", "$description": "daisyUI 'bumblebee' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(97% 0 0)", "$description": "daisyUI 'bumblebee' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(55% 0.02 0)" },

  "accent": { "$type": "color", "$value": "oklch(97% 0.02 0)", "$description": "daisyUI 'bumblebee' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(70% 0.191 22.216)", "$description": "daisyUI 'bumblebee' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(39% 0.141 25.723)", "$description": "daisyUI 'bumblebee' error-content" },

  "info": { "$type": "color", "$value": "oklch(74% 0.16 232.661)", "$description": "daisyUI 'bumblebee' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(39% 0.09 240.876)", "$description": "daisyUI 'bumblebee' info-content" },
  "success": { "$type": "color", "$value": "oklch(76% 0.177 163.223)", "$description": "daisyUI 'bumblebee' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(37% 0.077 168.94)", "$description": "daisyUI 'bumblebee' success-content" },
  "warning": { "$type": "color", "$value": "oklch(82% 0.189 84.429)", "$description": "daisyUI 'bumblebee' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(41% 0.112 45.904)", "$description": "daisyUI 'bumblebee' warning-content" },

  "border": { "$type": "color", "$value": "oklch(92% 0 0)", "$description": "daisyUI 'bumblebee' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'bumblebee' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
