{
  "$description": "daisyUI 'forest' theme, remapped to shadcn's CSS variable naming convention.",
  "radius": { "$type": "dimension", "$value": "1rem", "$description": "daisyUI 'forest' theme's own --radius-box value. Note: this theme's own --radius-field is 2rem, notably larger than box — the box anchor undershoots this theme's field roundness. See design.md for the box-anchor compromise." },
  "background": { "$type": "color", "$value": "oklch(20.84% 0.008 17.911)", "$description": "daisyUI 'forest' base-100" },
  "foreground": { "$type": "color", "$value": "oklch(83.768% 0.001 17.911)", "$description": "daisyUI 'forest' base-content" },

  "card": { "$type": "color", "$value": "{background}" },
  "card-foreground": { "$type": "color", "$value": "{foreground}" },
  "popover": { "$type": "color", "$value": "{background}" },
  "popover-foreground": { "$type": "color", "$value": "{foreground}" },

  "primary": { "$type": "color", "$value": "oklch(68.628% 0.185 148.958)", "$description": "daisyUI 'forest' primary" },
  "primary-foreground": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'forest' primary-content" },

  "secondary": { "$type": "color", "$value": "oklch(18.522% 0.03 168.327)", "$description": "daisyUI 'forest' secondary HUE, re-derived to shadcn's subtle-secondary tonal role at muted's own lightness" },
  "secondary-foreground": { "$type": "color", "$value": "{foreground}" },

  "muted": { "$type": "color", "$value": "oklch(18.522% 0.007 17.911)", "$description": "daisyUI 'forest' base-200" },
  "muted-foreground": { "$type": "color", "$value": "oklch(65% 0.02 17.911)" },

  "accent": { "$type": "color", "$value": "oklch(18.522% 0.02 185.713)", "$description": "daisyUI 'forest' accent HUE, re-derived to shadcn's subtle-accent tonal role at muted's own lightness" },
  "accent-foreground": { "$type": "color", "$value": "{foreground}" },

  "destructive": { "$type": "color", "$value": "oklch(71.76% 0.221 22.18)", "$description": "daisyUI 'forest' error" },
  "destructive-foreground": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'forest' error-content" },

  "info": { "$type": "color", "$value": "oklch(72.06% 0.191 231.6)", "$description": "daisyUI 'forest' info" },
  "info-foreground": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'forest' info-content" },
  "success": { "$type": "color", "$value": "oklch(64.8% 0.15 160)", "$description": "daisyUI 'forest' success" },
  "success-foreground": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'forest' success-content" },
  "warning": { "$type": "color", "$value": "oklch(84.71% 0.199 83.87)", "$description": "daisyUI 'forest' warning" },
  "warning-foreground": { "$type": "color", "$value": "oklch(0% 0 0)", "$description": "daisyUI 'forest' warning-content" },

  "border": { "$type": "color", "$value": "oklch(16.203% 0.007 17.911)", "$description": "daisyUI 'forest' base-300" },
  "input": { "$type": "color", "$value": "{border}" },
  "ring": { "$type": "color", "$value": "{primary}" },

  "chart-1": { "$type": "color", "$value": "{primary}" },
  "chart-2": { "$type": "color", "$value": "oklch(70.628% 0.119 185.713)", "$description": "daisyUI 'forest' accent, bold — used directly here since charts need contrast" },
  "chart-3": { "$type": "color", "$value": "{info}" },
  "chart-4": { "$type": "color", "$value": "{success}" },
  "chart-5": { "$type": "color", "$value": "{warning}" },

  "sidebar": { "$type": "color", "$value": "{background}" },
  "sidebar-foreground": { "$type": "color", "$value": "{foreground}" },
  "sidebar-primary": { "$type": "color", "$value": "{primary}" },
  "sidebar-primary-foreground": { "$type": "color", "$value": "{primary-foreground}" },
  "sidebar-accent": { "$type": "color", "$value": "{accent}" },
  "sidebar-accent-foreground": { "$type": "color", "$value": "{accent-foreground}" },
  "sidebar-border": { "$type": "color", "$value": "{border}" },
  "sidebar-ring": { "$type": "color", "$value": "{primary}" }
}
